# ── App ─────────────────────────────────────────────────────────────
PORT=3000
MICROSERVICE_PORT=3001
NODE_ENV=development

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# ── Pinecone ──────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=aml-knowledge-base
PINECONE_ENVIRONMENT=us-east-1

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.70

# ── Namespaces ───────────────────────────────────────────────────────
NS_FINCEN=fincen-typologies
NS_FATF=fatf-guidance
NS_SAR=sar-cases
